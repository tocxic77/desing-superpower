{
  "name": "design-superpowers",
  "version": "0.1.0",
  "description": "Autonomous agent architecture for design, execution, and commercial optimization",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch tools/orchestrator/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "validate:contrast": "tsx tools/validators/contrast_analyzer.ts",
    "validate:a11y": "tsx tools/validators/accessibility_audit.ts",
    "validate:performance": "tsx tools/validators/performance_audit.ts",
    "validate:visual": "tsx tools/validators/visual_regression.ts",
    "validate:responsive": "tsx tools/validators/responsive_analyzer.ts",
    "validate:conversion": "tsx tools/validators/conversion_audit.ts",
    "validate:hierarchy": "tsx tools/validators/visual_hierarchy.ts",
    "validate:typography": "tsx tools/validators/typography_audit.ts",
    "mcp:wp": "tsx tools/mcp/wordpress_elementor/index.ts",
    "mcp:figma": "tsx tools/mcp/figma/index.ts",
    "mcp:browser": "tsx tools/mcp/browser/index.ts",
    "mcp:analytics": "tsx tools/mcp/analytics/index.ts",
    "mcp:assets": "tsx tools/mcp/asset_manager/index.ts"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "axe-core": "^4.8.0",
    "lighthouse": "^11.0.0",
    "chrome-launcher": "^1.1.0",
    "pixeldiff": "^1.0.0",
    "sharp": "^0.33.0",
    "zod": "^3.22.0",
    "yaml": "^2.3.0",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0",
    "@types/node": "^20.10.0"
  },
  "packageManager": "pnpm@8.15.0"
}