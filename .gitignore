# Design Superpowers — Git Ignore

# Environment
.env
.env.local
.env.*.local

# Runtime artifacts
runs/
reports/
*.log
*.tmp

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Build
dist/
build/
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Lighthouse
.lighthouseci/

# Screenshots (large, regenerated)
runs/*/screenshots/*.png
!runs/*/screenshots/.gitkeep

# Diffs (regenerated)
runs/*/diff/*
!runs/*/diff/.gitkeep

# Assets (project-specific, regenerated)
assets/projects/

# Cache
.cache/
.turbo/

# Vercel/Netlify
.vercel/
.netlify/

# Local development
*.local.md
local-*