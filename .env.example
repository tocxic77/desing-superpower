# Design Superpowers — Environment Configuration
# Copy to .env and fill in your values

# ============================================================
# HERMES / LLM CONFIGURATION
# ============================================================
HERMES_PROFILE=default
HERMES_MODEL=nvidia/nemotron-3-ultra
HERMES_PROVIDER=nvidia
HERMES_API_KEY=your_api_key_here

# ============================================================
# WORDPRESS / ELEMENTOR
# ============================================================
WP_URL=https://your-staging-site.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_app_password
WP_ELEMENTOR_VERSION=3.20

# Production (requires explicit approval)
WP_PROD_URL=https://your-production-site.com
WP_PROD_USERNAME=prod_user
WP_PROD_APP_PASSWORD=prod_app_password

# ============================================================
# FIGMA
# ============================================================
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token
FIGMA_TEAM_ID=your_team_id
FIGMA_FILE_KEYS=file_key_1,file_key_2

# ============================================================
# ANALYTICS / CONVERSION
# ============================================================
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret
GA4_PROPERTY_ID=123456789

GSC_SITE_URL=https://your-site.com
CLARITY_PROJECT_ID=your_clarity_project_id

# CRM / Forms
HUBSPOT_API_KEY=your_hubspot_key
ACTIVECAMPAIGN_URL=your_account.api-us1.com
ACTIVECAMPAIGN_KEY=your_activecampaign_key

# ============================================================
# VALIDATION THRESHOLDS (override defaults)
# ============================================================
# Accessibility
A11Y_CONTRAST_AA_NORMAL=4.5
A11Y_CONTRAST_AA_LARGE=3.0
A11Y_CONTRAST_UI=3.0
A11Y_TOUCH_TARGET_MIN=44

# Performance (Core Web Vitals)
PERF_LCP_MS=2500
PERF_INP_MS=200
PERF_CLS=0.10

# Visual QA
VISUAL_OVERFLOW_TOLERANCE=0
VISUAL_REGRESSION_THRESHOLD=0.05

# ============================================================
# DESIGN LOOP SETTINGS
# ============================================================
DESIGN_LOOP_MAX_ITERATIONS=5
DESIGN_LOOP_MAX_ISSUE_RETRIES=3
DESIGN_LOOP_AUTO_FIX_HIGH=true
DESIGN_LOOP_AUTO_FIX_MEDIUM=true
DESIGN_LOOP_AUTO_FIX_LOW=false

# ============================================================
# OUTPUT / STORAGE
# ============================================================
RUNS_DIR=./runs
REPORTS_DIR=./reports
SCREENSHOTS_DIR=./runs/screenshots
ASSETS_DIR=./assets

# ============================================================
# DEVELOPMENT
# ============================================================
LOG_LEVEL=info
DEBUG_PLAYWRIGHT=false
HEADLESS=true
SLOW_MO=0